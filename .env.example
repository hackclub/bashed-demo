# Postgres, run with `pnpm db:up` (the postgres service in compose.yaml)
POSTGRES_USER=bashed_demo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bashed_demo
POSTGRES_PORT=5434
DATABASE_URL=postgresql://bashed_demo:change-me@localhost:5434/bashed_demo

# Shared with Bashed, which signs its requests with it. Make one with `openssl rand -hex 32`.
BASHED_SECRET=

# Optional GitHub tokens, separated by commas, for cloning from GitHub. Fine-grained ones with
# "Public repositories" access and no permissions, so private repositories stay out of reach.
GITHUB_TOKENS=

# Where the dev server finds the virtual machine's disk (built with `pnpm disk:build`)
DISK_PATH=.data/disk/disk.ext2

# Bashed, linked from the header
BASHED_URL=https://bashed.hackclub.com

# The demo site's own port in compose.yaml
APP_PORT=3001
